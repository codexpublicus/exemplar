{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codexpublicus/exemplar/schema/courts-registry.schema.json",
  "title": "Court record key: court registry",
  "description": "registry/courts.json; spec/court-record-key.md sections 4 and 10.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry", "version", "spec", "spec_version", "description", "source", "excluded", "courts"],
  "properties": {
    "registry": {"const": "courts"},
    "version": {
      "description": "CalVer snapshot version, YYYY.MM.DD[.N]",
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12][0-9]|3[01])(\\.[1-9][0-9]*)?$"
    },
    "spec": {"const": "spec/court-record-key.md"},
    "spec_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "publisher", "repository", "commit", "commit_date", "path",
        "vendored_copy", "retrieved", "license_as_stated", "sha256"
      ],
      "properties": {
        "name": {"type": "string"},
        "publisher": {"type": "string"},
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_date": {"type": "string", "format": "date-time"},
        "path": {"type": "string"},
        "vendored_copy": {"type": "string"},
        "retrieved": {"type": "string", "format": "date"},
        "license_as_stated": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "excluded": {
      "description": "Source ids left out of the registry, with the reason",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "courts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/court"}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "court": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "name", "profiles", "source"],
      "properties": {
        "country": {"const": "us"},
        "name": {"type": "string", "minLength": 1},
        "profiles": {
          "description": "Docket profiles in date order; each applies from its date (null: from the start) until the next. An empty list: no profile for any date.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "profile"],
            "properties": {
              "from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
              "profile": {"enum": ["scotus-ot1971", "us-coa", "us-district", "printed"]}
            }
          }
        },
        "aliases": {
          "description": "Other services' ids for the same court (spec section 10.1)",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "replaced-by": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "source": {
          "description": "Where the code came from: courts-db, or exemplar for a code this registry minted",
          "enum": ["courts-db", "exemplar"]
        }
      }
    }
  }
}
