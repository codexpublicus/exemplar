{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codexpublicus/exemplar/schema/reporter-variants.schema.json",
  "title": "Court record key: reporter variant map",
  "description": "registry/reporter-variants.json; spec/court-record-key.md sections 5.6 and 10.1 (from 0.7.0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry", "version", "spec", "spec_version", "description", "source", "variants", "unresolved"],
  "properties": {
    "registry": {"const": "reporter-variants"},
    "version": {"type": "string", "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12][0-9]|3[01])(\\.[1-9][0-9]*)?$"},
    "spec": {"const": "spec/court-record-key.md"},
    "spec_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "description": "The reporters-db snapshot the reporters-db entries are taken from, vendored unchanged",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "publisher", "repository", "release", "commit", "commit_date", "path",
        "vendored_copy", "retrieved", "license_as_stated", "sha256"
      ],
      "properties": {
        "name": {"const": "reporters-db"},
        "publisher": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"},
        "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit_date": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "vendored_copy": {"type": "string", "minLength": 1},
        "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "license_as_stated": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "variants": {
      "description": "Spec section 5.6: a spelling, whitespace runs collapsed to one space, to the abbreviation whose slug a key uses",
      "type": "object",
      "propertyNames": {"minLength": 1, "pattern": "^\\S+( \\S+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["abbreviation", "basis"],
        "properties": {
          "abbreviation": {"type": "string", "minLength": 1},
          "basis": {"enum": ["reporters-db", "curated"]},
          "note": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"basis": {"const": "curated"}}},
        "then": {"required": ["note"]},
        "else": {"not": {"required": ["note"]}}
      }
    },
    "unresolved": {
      "description": "Variations reporters-db gives several editions for that no curated entry resolves; each is its own abbreviation",
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
    }
  }
}
