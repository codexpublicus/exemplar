{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codexpublicus/exemplar/schema/cap-courts.schema.json",
  "title": "Court record key: CAP courts to court registry codes",
  "description": "registry/cap-courts.json; spec/court-record-key.md section 10.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry", "version", "courts_registry_version", "spec", "spec_version", "description",
    "provenance", "bases", "source", "courts", "unmapped"
  ],
  "properties": {
    "registry": {"const": "cap-courts"},
    "version": {"type": "string", "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12][0-9]|3[01])(\\.[1-9][0-9]*)?$"},
    "courts_registry_version": {"type": "string"},
    "spec": {"const": "spec/court-record-key.md"},
    "spec_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["engine-output", "hand-checked", "human-curated"]},
    "bases": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "source": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "courts": {
      "description": "CAP court id to the registry codes for its decisions, by date",
      "type": "object",
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "jurisdiction", "cases", "codes", "basis"],
        "properties": {
          "name": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "cases": {"type": "integer", "minimum": 1},
          "codes": {
            "description": "Registry codes in date order; each applies from its date (null: from the start) until the next",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "code"],
              "properties": {
                "from": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
                "code": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
              }
            }
          },
          "basis": {"type": "string"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "unmapped": {
      "description": "CAP courts with no code, and why",
      "type": "object",
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "jurisdiction", "cases", "reason"],
        "properties": {
          "name": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "cases": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
